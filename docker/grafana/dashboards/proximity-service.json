{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "ST_DWithin 쿼리 Latency (p50/p95/p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(proximity_search_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(proximity_search_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(proximity_search_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "데이터 규모별 쿼리 성능 변화",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(proximity_search_query_duration_seconds_sum[5m]) / rate(proximity_search_query_duration_seconds_count[5m])",
          "legendFormat": "avg latency"
        },
        {
          "expr": "proximity_search_query_duration_seconds_max",
          "legendFormat": "max latency"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio 실시간 추이",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 20 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "proximity_cache_hit_ratio",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "title": "GIST 인덱스 크기",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 104857600 },
              { "color": "red", "value": 536870912 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_relation_size_bytes{relname=\"idx_businesses_location\"}",
          "legendFormat": "GIST index size"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["proximity-service"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Proximity Service Dashboard",
  "uid": "proximity-service",
  "version": 1
}
